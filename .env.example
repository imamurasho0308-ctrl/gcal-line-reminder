# ローカルで試すとき用。実際の値を入れて `.env` にコピーし、
#   set -a; source .env; set +a; python src/reminder.py
# のように読み込む。GitHub 上では Secrets に登録するのでこのファイルは使わない。

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

CALENDAR_IDS=primary
REMIND_BEFORE_MINUTES=30
WINDOW_MINUTES=60
TIMEZONE=Asia/Tokyo
SKIP_ALL_DAY=true
DRY_RUN=true
